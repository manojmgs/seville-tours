{
  "name": "seville-tours",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "seo:manifest": "node scripts/generate-seo-manifest.mjs",
    "build": "node scripts/generate-seo-manifest.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "video": "remotion studio remotion/index.ts",
    "video:voiceover": "node scripts/generate-voiceover.mjs",
    "video:music": "node scripts/generate-music.mjs",
    "video:render": "remotion render remotion/index.ts ConciergePromo out/isabel-concierge-promo.mp4",
    "video:render:square": "remotion render remotion/index.ts ConciergePromoSquare out/isabel-concierge-promo-square.mp4",
    "video:still": "remotion still remotion/index.ts ConciergePromo out/isabel-concierge-poster.png --frame=70"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.484",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^26.1.0",
    "remotion": "^4.0.484",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
